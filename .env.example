# ────────────────────────────────────────────────────────────────
# Chomp Sandwich — environment variables (EXAMPLE)
# Copy this file to `.env` and fill in real values.
# Full step-by-step guide: docs/deployment.html
# ────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local dev example:
#   postgresql://postgres:postgres@localhost:5432/chomp?schema=public
# Neon (free, production) gives you a string like:
#   postgresql://USER:PASS@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chomp?schema=public"

# Auth.js (NextAuth v5)
# Generate with:  npx auth secret    (or)   openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public site URL (use http://localhost:3000 in dev)
AUTH_URL="http://localhost:3000"

# Kavenegar SMS (OTP delivery). Get a free key at https://panel.kavenegar.com
KAVENEGAR_API_KEY=""
# Optional pre-approved OTP template name (recommended for Iranian carriers)
KAVENEGAR_OTP_TEMPLATE="chomp-otp"
# Sender line number (only used for plain SMS fallback)
KAVENEGAR_SENDER=""

# Redis (Upstash, free) — optional but recommended for OTP store + rate limiting.
# If left blank, the app falls back to the database for OTP storage.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Set to "1" to print OTP codes to the server console instead of sending SMS
# (handy for local development without a Kavenegar key).
OTP_DEV_MODE="1"

# First admin account created by the seeder.
ADMIN_PHONE="09120000000"
ADMIN_PASSWORD="ChangeMe123!"
